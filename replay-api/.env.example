# Banco de dados (Postgres — ex: Supabase, Neon, Railway)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# true quando o certificado TLS do provedor for válido (recomendado em produção).
# Deixe false se o pooler (Supabase/Neon) falhar com erro de certificado.
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# JWT (aluno)
JWT_SECRET=troque_por_uma_string_aleatoria_bem_longa

# Chave usada no blind index do e-mail (HMAC) — NUNCA reaproveite o JWT_SECRET aqui
EMAIL_HASH_KEY=troque_por_outra_string_aleatoria_bem_longa

# Chave usada para criptografar o e-mail (AES-256-GCM precisa de 32 bytes em hex = 64 caracteres)
EMAIL_ENCRYPTION_KEY=troque_por_64_caracteres_hexadecimais_aleatorios

# Backblaze B2 (API compatível com S3)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=nome-do-seu-bucket
B2_ACCESS_KEY_ID=sua_key_id
B2_SECRET_ACCESS_KEY=sua_application_key

# Resend (envio de OTP)
RESEND_API_KEY=re_sua_api_key
RESEND_FROM=Replay <onboarding@resend.dev>

# Origem exata do front (CORS). Sem barra no final.
# Local: http://localhost:3000  |  hlg/prod: URL pública do replay-app
FRONTEND_URL=http://localhost:3000

PORT=3000
